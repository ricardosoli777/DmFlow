# ============================================
# DMFlow — variáveis de ambiente
# Copie este arquivo para ".env" e preencha.
# Nunca commite o ".env" de verdade.
# ============================================

# Credenciais manuais da Meta (tokens, IG User ID) NÃO vão aqui — cada
# workspace conecta suas próprias contas Instagram direto pelo dashboard, em
# Configurações (RF17). Guia completo: docs/04-integracao-meta.md

# --- Banco de dados (Postgres) ---
POSTGRES_USER=dmflow
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=dmflow
DATABASE_URL=postgresql://dmflow:troque_esta_senha@postgres:5432/dmflow

# --- Redis (fila) ---
REDIS_URL=redis://redis:6379

# --- MinIO (armazenamento de mídia) ---
MINIO_ROOT_USER=dmflow
MINIO_ROOT_PASSWORD=troque_esta_senha_tambem

# --- Backend / autenticação ---
PORT=4000
JWT_SECRET=troque_por_uma_string_aleatoria_longa
# Chave Base64 de 32 bytes para cifrar App Secret, Verify Token e Access Token
# da Meta no banco. Gere com: openssl rand -base64 32
META_CREDENTIALS_ENCRYPTION_KEY=
# URL pública do backend — usada pra montar o link de redirect dos "links
# rastreados" (RF14) que saem nas mensagens (ex: https://hooks.example.com).
# Em dev local pode deixar como está.
PUBLIC_API_URL=http://localhost:4000
# URL pública do dashboard — usada pra montar o link de login por e-mail
# (RNF10). Em dev local pode deixar como está.
PUBLIC_APP_URL=http://localhost:3000
# --- OAuth pessoal da Meta ---
# Necessário apenas para o botão "Conectar com Meta/Instagram (OAuth)".
# O callback deve ser cadastrado exatamente assim no app Meta:
# {META_OAUTH_REDIRECT_URI}
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
META_OAUTH_REDIRECT_URI=
# Opcional, porém recomendado para uso pessoal: ID da Página Facebook que
# deve ser conectada. Evita depender da listagem /me/accounts da Meta.
META_OAUTH_PAGE_ID=


# --- Cadastro e login por e-mail (RNF10 — sem senha) ---
# Opcional: se preenchido, este e-mail já terá uma conta e um workspace no
# primeiro boot e poderá entrar em /login. Se vazio, use /register para criar
# a primeira conta por link de confirmação.
DASHBOARD_ADMIN_EMAIL=
# Sem nenhuma opção abaixo preenchida, o link de login só é IMPRESSO NO
# CONSOLE do backend (funciona pra testar local, mas ninguém recebe e-mail
# de verdade). Preencha UMA das duas — passo a passo de cada uma no
# README.md, seção "Login por e-mail":
#
# Opção 1 — Resend (recomendado: melhor entrega, mas exige domínio próprio verificado)
RESEND_API_KEY=
#
# Opção 2 — Gmail com senha de app (sem domínio, mais simples de começar,
# mas limite de ~500 e-mails/dia e mais chance de cair em spam)
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# Usado pelas duas opções — troque pelo seu remetente verificado antes de
# ativar o envio real. As aspas também permitem carregar o arquivo no Swarm.
EMAIL_FROM="DMFlow <login@example.invalid>"

# --- Frontend ---
# IMPORTANTE: essa variável é "gravada" dentro dos arquivos do site no momento
# do build (não é lida depois, rodando) — se você mudar isso, precisa rodar
# `docker compose build frontend` de novo pra valer (não basta reiniciar).
# O setup local sempre compila o frontend com este endereço. Em produção,
# coloque a URL HTTPS pública da API e reconstrua a imagem.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Somente para deploy avançado com Docker Swarm/Traefik ---
# Não é necessário preencher para instalação local via Docker Compose.
DMFLOW_IMAGE_REPOSITORY=
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
