# ============================================
# DMFlow — variáveis de ambiente
# Copie este arquivo para ".env" e preencha.
# Nunca commite o ".env" de verdade.
# ============================================

# --- Credenciais do app Meta (developers.facebook.com) ---
# Guia completo: docs/04-integracao-meta.md
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Token que você mesmo inventa (ex: uma senha aleatória) e usa também
# na configuração do webhook no painel da Meta.
META_VERIFY_TOKEN=troque_por_um_token_aleatorio

# --- Banco de dados (Postgres) ---
POSTGRES_USER=dmflow
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=dmflow
DATABASE_URL=postgresql://dmflow:troque_esta_senha@postgres:5432/dmflow

# --- Redis (fila) ---
REDIS_URL=redis://redis:6379

# --- MinIO (armazenamento de mídia) ---
MINIO_ROOT_USER=dmflow
MINIO_ROOT_PASSWORD=troque_esta_senha_tambem

# --- Backend / autenticação ---
PORT=4000
JWT_SECRET=troque_por_uma_string_aleatoria_longa

# --- Login inicial do dashboard (criado automaticamente no primeiro start) ---
DASHBOARD_ADMIN_EMAIL=voce@exemplo.com
DASHBOARD_ADMIN_PASSWORD=troque_esta_senha_tambem

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
